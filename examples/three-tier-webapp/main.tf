terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}


locals {
  common_tags = {
    Project     = "Three-Tier Web App"
    Environment = var.environment
    ManagedBy   = "Inkfra"
  }
}


# Generated by Inkfra - Visual-to-IaC Canvas
# Project: Three-Tier Web App

resource "aws_vpc" "main_vpc" {
  cidr_block = "10.0.0.0/16"
  tags       = merge(local.common_tags, { Name = "main-vpc" })
}

resource "aws_subnet" "public_subnet_a" {
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = true
  vpc_id                  = aws_vpc.main_vpc.id
  tags                    = merge(local.common_tags, { Name = "public-a" })
  depends_on              = [aws_vpc.main_vpc]
}

resource "aws_subnet" "public_subnet_b" {
  cidr_block              = "10.0.2.0/24"
  availability_zone       = "us-east-1b"
  map_public_ip_on_launch = true
  vpc_id                  = aws_vpc.main_vpc.id
  tags                    = merge(local.common_tags, { Name = "public-b" })
  depends_on              = [aws_vpc.main_vpc]
}

resource "aws_subnet" "private_subnet_a" {
  cidr_block        = "10.0.11.0/24"
  availability_zone = "us-east-1a"
  vpc_id            = aws_vpc.main_vpc.id
  tags              = merge(local.common_tags, { Name = "private-a" })
  depends_on        = [aws_vpc.main_vpc]
}

resource "aws_subnet" "private_subnet_b" {
  cidr_block        = "10.0.12.0/24"
  availability_zone = "us-east-1b"
  vpc_id            = aws_vpc.main_vpc.id
  tags              = merge(local.common_tags, { Name = "private-b" })
  depends_on        = [aws_vpc.main_vpc]
}

resource "aws_internet_gateway" "internet_gateway" {
  vpc_id     = aws_vpc.main_vpc.id
  tags       = merge(local.common_tags, { Name = "igw" })
  depends_on = [aws_vpc.main_vpc]
}

resource "aws_lb" "application_lb" {
  load_balancer_type = "application"
  internal           = false
  name               = "alb"
  subnets            = [aws_subnet.public_subnet_a.id, aws_subnet.public_subnet_b.id]
  tags               = merge(local.common_tags, { Name = "alb" })
}

resource "aws_instance" "web_server_1" {
  instance_type = "t3.small"
  ami           = "ami-0c55b159cbfafe1f0"
  tags          = merge(local.common_tags, { Name = "web-1" })
  depends_on    = [aws_subnet.private_subnet_a]
}

resource "aws_instance" "web_server_2" {
  instance_type = "t3.small"
  ami           = "ami-0c55b159cbfafe1f0"
  tags          = merge(local.common_tags, { Name = "web-2" })
  depends_on    = [aws_subnet.private_subnet_b]
}

resource "aws_db_instance" "postgresql_db" {
  engine            = "postgres"
  instance_class    = "db.t3.small"
  allocated_storage = 20
  username          = "appuser"
  password          = "changeme"
  db_name           = "appdb"
  tags              = local.common_tags
  depends_on        = [aws_subnet.private_subnet_a]
}

resource "aws_security_group" "web_sg" {
  name        = "web-sg"
  description = "Allow HTTP/HTTPS"
  tags        = merge(local.common_tags, { Name = "web-sg" })
}

resource "aws_security_group" "db_sg" {
  name        = "db-sg"
  description = "Allow Postgres from web"
  tags        = merge(local.common_tags, { Name = "db-sg" })
}

resource "aws_s3_bucket" "assets_bucket" {
  bucket = "app-assets-bucket"
  acl    = "private"
  versioning {
    enabled = true
  }
  tags = local.common_tags
}

# --- Connections ---
# Application LB --[connects]--> Public Subnet A
# Application LB --[connects]--> Public Subnet B
# Web Server 1 --[connects]--> Web SG
# Web Server 2 --[connects]--> Web SG
# PostgreSQL DB --[connects]--> DB SG
# Assets Bucket --[connects]--> Main VPC
