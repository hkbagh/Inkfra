{
  "name": "inkfra",
  "private": true,
  "version": "0.2.0-alpha.1",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Visual-to-IaC canvas that converts architecture diagrams into ready-to-use Terraform code.",
  "author": "Harekrishna Bagh",
  "license": "MIT",
  "homepage": "https://github.com/harekrishnabagh/inkfra#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/harekrishnabagh/inkfra.git"
  },
  "bugs": {
    "url": "https://github.com/harekrishnabagh/inkfra/issues"
  },
  "keywords": [
    "iac",
    "terraform",
    "infrastructure-as-code",
    "diagram",
    "canvas",
    "devops",
    "cloud",
    "aws",
    "azure",
    "gcp",
    "react"
  ],
  "build": {
    "appId": "com.harekrishnabagh.inkfra",
    "productName": "Inkfra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node scripts/serve.mjs",
    "build:serve": "npm run build && npm run start",
    "electron:dev": "npm run dev & electron .",
    "electron:build": "npm run build && electron-builder --win --linux",
    "package:sea": "node scripts/package-sea.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^14.10.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "husky": "^9.1.7",
    "oxlint": "^1.90.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
